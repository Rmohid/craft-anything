#!/usr/bin/env python3
"""state-check sdlc-state/v1 - the mechanical gate behind the sdlc-state skill.

Usage:
  state-check --struct [--final] [--hook]  parse-only checks (fast; runs nothing)
  state-check --run    [--final]           --struct plus re-run every REQ test and wire check
  state-check doctor                       verify the gates are installed here (anti wiring-drift)
  state-check version                      print the version string

Exit codes: 0 ok | 1 findings | 2 findings in --hook mode (a blocking hook).

Python 3 standard library only. Commands read from STATE.md run with the same
trust as the project's own test suite.
"""

import glob
import json
import os
import pathlib
import re
import subprocess
import sys

VERSION = "state-check 1.0.0"
SCHEMA = "sdlc-state/v1"
STATE_GLOB = "docs/superpowers/state/*/STATE.md"

HEADER_KEYS = ("schema", "spec", "plan", "ledger", "test_cmd", "beads")
STEP_RE = re.compile(r"^(\s*)- \[([ x~!\-])\] (S\d+[a-z0-9]*)\b(.*)$")
INLINE_FIELD_RE = re.compile(r"(?:^|\|)\s*(kind|req|plan|est|bead)\s*:\s*([^|]*)")
FIELD_RE = re.compile(r"^\s+- (check|expect|evidence):\s*(.*)$")
REQ_ID_RE = re.compile(r"^R\d+$")
TP_ID_RE = re.compile(r"^T\d+$")
EVIDENCE_RE = re.compile(r"^[0-9a-f]{7,40} \u00b7 ")
MARK_VALID = " x~!-"
KIND_VALID = {"gate", "spec", "plan", "build", "spike", "wire", "route", "review", "finish"}
STATUS_VALID = {"open", "planned", "built", "covered"}


def git_root():
    try:
        out = subprocess.run(
            ["git", "rev-parse", "--show-toplevel"],
            capture_output=True, text=True, check=False,
        ).stdout.strip()
    except OSError:
        out = ""
    return pathlib.Path(out) if out else pathlib.Path.cwd()


def tick(value):
    return value.strip().strip("`").strip()


def split_row(line):
    """Split a markdown table row into stripped cells (drops the outer pipes)."""
    cells = [c.strip() for c in line.strip().strip("|").split("|")]
    return cells


def parse(path):
    st = {
        "path": path,
        "hdr": {},
        "req": {},
        "tp": {},
        "steps": {},
        "order": [],
        "errors": [],
    }
    text = path.read_text(encoding="utf-8", errors="replace")
    cur = None
    section = ""
    for line in text.splitlines():
        stripped = line.strip()
        if stripped.startswith("## "):
            section = stripped[3:].strip().lower()
            cur = None
            continue
        m = STEP_RE.match(line)
        if m:
            sid = m.group(3)
            rest = m.group(4)
            title = re.split(r"\s\|\s*kind\s*:", rest, maxsplit=1)[0].strip()
            cur = sid
            st["order"].append(sid)
            st["steps"][sid] = {
                "mark": m.group(2),
                "title": title,
                "kind": "", "req": "", "plan": "", "est": "", "bead": "",
                "check": "", "expect": "", "evidence": "",
            }
            for key, val in INLINE_FIELD_RE.findall(rest):
                st["steps"][sid][key] = val.strip()
            continue
        m = FIELD_RE.match(line)
        if m and cur:
            key, val = m.group(1), m.group(2).strip()
            # A field line must be the first such key under a step; later
            # duplicates mean two steps share a block, which the parser refuses
            # to guess about.
            if st["steps"][cur][key]:
                st["errors"].append(f"{cur}: duplicate `{key}:` field")
            st["steps"][cur][key] = val
            continue
        if stripped.startswith("|"):
            cells = split_row(stripped)
            if not cells:
                continue
            head = cells[0]
            if REQ_ID_RE.match(head) and len(cells) >= 7:
                st["req"][head] = {
                    "behavior": cells[1], "consumer": cells[2], "entry": tick(cells[3]),
                    "tests": [t.strip() for t in cells[4].split(",") if t.strip()],
                    "w": tick(cells[5]), "status": cells[6].lower(),
                }
            elif TP_ID_RE.match(head) and len(cells) >= 5:
                st["tp"][head] = {
                    "file": tick(cells[1]), "must": tick(cells[2]),
                    "req": cells[3], "status": cells[4].lower(),
                }
            continue
        # header key: value lines (top of file)
        m = re.match(r"^([a-z_]+):\s*(.*)$", line)
        if m and not cur and m.group(1) in HEADER_KEYS and section == "":
            st["hdr"][m.group(1)] = m.group(2).strip()
    return st


def spec_reqs(spec):
    """Requirement id -> number of `example:` + `edge:` lines in the spec appendix."""
    out = {}
    cur = None
    for line in spec.read_text(encoding="utf-8", errors="replace").splitlines():
        m = re.match(r"^### (R\d+)\b", line)
        if m:
            cur = m.group(1)
            out[cur] = 0
        elif cur and re.match(r"^\s*- (example|edge):", line):
            out[cur] += 1
    return out


def children_of(st, sid):
    return [s for s in st["order"] if s != sid and s.startswith(sid)]


def struct(st, root, final):
    errs = list(st["errors"])
    hdr = st["hdr"]

    if hdr.get("schema", "") != SCHEMA:
        errs.append(f"schema must be `{SCHEMA}` (found `{hdr.get('schema', '')}`)")

    spec = root / hdr.get("spec", "")
    if not hdr.get("spec") or not spec.is_file():
        errs.append(f"spec not found: {spec}")
        sr = {}
    else:
        sr = spec_reqs(spec)

    plan = root / hdr.get("plan", "")
    if not hdr.get("plan"):
        errs.append("plan path missing from the header")
    elif not plan.is_file():
        errs.append(f"plan not found: {plan}")

    # Gap 4: the spec's requirement ids and the state's must be the same set.
    if set(sr) != set(st["req"]):
        errs.append(
            f"REQ drift: spec has {sorted(sr) or 'none'}, STATE has {sorted(st['req']) or 'none'}"
        )

    if not st["req"]:
        errs.append("no requirement rows")

    # Gap 1: every requirement is mapped to tests, one per example/edge at least.
    for rid, row in st["req"].items():
        status = row["status"]
        if status not in STATUS_VALID:
            errs.append(f"{rid}: status `{status}` not one of {sorted(STATUS_VALID)}")
        if not row["tests"]:
            errs.append(f"{rid}: no tests mapped")
        if len(row["tests"]) < sr.get(rid, 0):
            errs.append(
                f"{rid}: spec has {sr[rid]} example/edge lines but only "
                f"{len(row['tests'])} tests mapped"
            )
        if status != "planned":
            for ref in row["tests"]:
                path_part, _, name = ref.partition("::")
                target = root / path_part
                if not target.is_file():
                    errs.append(f"{rid}: test file not found: {path_part}")
                elif name and not re.search(rf"\b{re.escape(name)}\b", target.read_text(
                        encoding="utf-8", errors="replace")):
                    errs.append(f"{rid}: test name not found in {path_part}: {name}")

        # Gap 2: a consumer-facing requirement needs a wire step that names its entry.
        if row["consumer"].lower() != "internal":
            wid = row["w"]
            step = st["steps"].get(wid)
            if not wid or not step:
                errs.append(f"{rid}: consumer `{row['consumer']}` but W-check names no step")
            else:
                if not row["entry"]:
                    errs.append(f"{rid}: consumer-facing but Entry is empty")
                elif row["entry"] not in step["check"]:
                    named = re.findall(r"[\w./-]+\.\w+", step["check"])
                    if not any(
                        (root / tok).is_file()
                        and row["entry"] in (root / tok).read_text(
                            encoding="utf-8", errors="replace")
                        for tok in named
                    ):
                        errs.append(
                            f"{rid}: wire step {wid} does not invoke entry `{row['entry']}`"
                        )
                if step["kind"] != "wire":
                    errs.append(f"{rid}: W-check {wid} must have kind: wire")
                if "--run" in step["check"]:
                    errs.append(
                        f"{rid}: wire step {wid} must not contain `--run` — "
                        "it recurses; the wire check calls `--struct`"
                    )
        if final and status != "covered":
            errs.append(f"{rid}: status `{status}` at final (must be covered)")

    # Gap 3: every touchpoint literal is present, or the row is a reasoned `none`.
    for tid, row in st["tp"].items():
        if not row["file"]:
            errs.append(f"{tid}: no file")
            continue
        if row["file"].startswith("none"):
            if len(row["file"]) < len("none - x"):
                errs.append(f"{tid}: a `none` touchpoint needs a reason")
            continue
        if row["status"] == "done" or final:
            target = root / row["file"]
            if not target.is_file():
                errs.append(f"{tid}: touchpoint file not found: {row['file']}")
            elif row["must"] and row["must"] not in target.read_text(
                    encoding="utf-8", errors="replace"):
                errs.append(f"{tid}: `{row['must']}` not in {row['file']}")

    ledger_path = root / hdr.get("ledger", "") if hdr.get("ledger") else None
    ledger = ""
    if ledger_path is not None:
        if ledger_path.is_file():
            ledger = ledger_path.read_text(encoding="utf-8", errors="replace")
        elif final:
            errs.append(f"ledger not found: {ledger_path}")
    else:
        errs.append("ledger path missing from the header")

    # Resume/ledger coherence (F9): the gate's own receipt must name one sha.
    if ledger:
        final_green = re.findall(r"FINAL-GREEN\s*\|\s*([0-9a-f]{7,40})", ledger)
        if final_green:
            raw = st["path"].read_text(encoding="utf-8", errors="replace") \
                if st["path"] and st["path"].is_file() else ""
            last_green = re.search(r"^-\s+last-green:\s*(\S+)", raw, re.M)
            if last_green and last_green.group(1) != final_green[-1]:
                errs.append(
                    f"last-green {last_green.group(1)} != FINAL-GREEN "
                    f"{final_green[-1]} — sync Resume with the ledger"
                )

    if not st["steps"]:
        errs.append("no steps")

    for sid in st["order"]:
        step = st["steps"][sid]
        mark = step["mark"]
        if mark not in MARK_VALID:
            errs.append(f"{sid}: unknown mark `[{mark}]`")
        if not step["check"]:
            errs.append(f"{sid}: no check command")
        if not step["expect"]:
            errs.append(f"{sid}: no expect")
        if step["kind"] not in KIND_VALID:
            errs.append(f"{sid}: kind `{step['kind']}` not one of {sorted(KIND_VALID)}")
        if not step["req"]:
            errs.append(f"{sid}: no req (use `-` for pure infrastructure)")
        m = re.match(r"^(\d+)\s*m$", step["est"])
        if not step["est"]:
            errs.append(f"{sid}: no estimate (est: <n>m)")
        elif not m:
            errs.append(f"{sid}: est `{step['est']}` must look like `25m`")
        elif int(m.group(1)) > 30:
            errs.append(f"{sid}: est {step['est']} exceeds the 30 minute ceiling; split it")
        if mark == "x" and not EVIDENCE_RE.match(step["evidence"]):
            errs.append(f"{sid}: [x] without evidence (want `<sha7> \u00b7 <date time> \u00b7 exit <n> \u00b7 \"<output>\"`)")
        if mark == "-" and not re.search(rf"\|\s*{re.escape(sid)}\s*\|[^|\n]*RULING", ledger):
            errs.append(f"{sid}: dropped without a RULING line in the ledger")
        if mark == "~":
            children = children_of(st, sid)
            if not children:
                errs.append(f"{sid}: split but has no children")
            elif st["steps"][children[-1]]["check"] != step["check"]:
                errs.append(
                    f"{sid}: the last child {children[-1]} must carry the parent's check"
                )
        if final and mark in " ~!":
            errs.append(f"{sid}: still [{mark}] at final")

    return errs


def shell(cmd, root):
    proc = subprocess.run(
        cmd, shell=True, cwd=str(root), capture_output=True, text=True, check=False
    )
    return proc.returncode, (proc.stdout or "") + (proc.stderr or "")


def _expect_hit(step, out):
    """Did a step's `expect` pass against the check's output?"""
    expect = step["expect"]
    if expect == "exit 0":
        return True
    if expect.startswith("`") and expect.endswith("`"):
        return tick(expect) in out
    return tick(expect) in out


def run(st, root):
    """Re-execute evidence: every [x] step's check, every mapped test, every wire check."""
    errs = []
    name = pathlib.Path(st["path"]).parent.name if st["path"] else "?"
    test_cmd = st["hdr"].get("test_cmd", "").strip()

    # S-steps are the state machine; evidence strings are self-attested prose
    # until the check is re-executed. Re-run every done step and hold it to its
    # declared expect. A check that invokes the gate itself (e.g. S13's
    # `state-check --run --final`) is the gate's own receipt, not evidence to
    # re-run — executing it would recurse without bound.
    for sid in st["order"]:
        step = st["steps"][sid]
        if step["mark"] != "x":
            continue
        cmd = tick(step["check"])
        if cmd == "true" or "scripts/state-check" in cmd:
            continue
        code, out = shell(cmd, root)
        if code != 0:
            errs.append(
                f"{sid}: check `{cmd}` exited {code} (recorded as exit 0): "
                f"{out.strip()[-120:]}"
            )
        elif not _expect_hit(step, out):
            errs.append(
                f"{sid}: check `{cmd}` output lacks expect `{tick(step['expect'])}`: "
                f"{out.strip()[-120:]}"
            )

    for rid, row in st["req"].items():
        if row["status"] == "planned":
            continue
        for ref in row["tests"]:
            path_part, _, ref_name = ref.partition("::")
            if not test_cmd:
                errs.append(f"{rid}: no test_cmd in the header, cannot run {ref}")
                break
            cmd = test_cmd.format(ref=ref, path=path_part, name=ref_name)
            code, out = shell(cmd, root)
            if code != 0:
                errs.append(f"{rid}: `{cmd}` exited {code}: {out.strip()[-300:]}")
        step = st["steps"].get(row["w"])
        if step and step["check"]:
            cmd = tick(step["check"])
            code, out = shell(cmd, root)
            if code != 0:
                errs.append(f"{rid}: wire {row['w']} `{cmd}` exited {code}: {out.strip()[-300:]}")
            elif not _expect_hit(step, out):
                errs.append(
                    f"{rid}: wire {row['w']} output lacks `{tick(step['expect'])}`: "
                    f"{out.strip()[-300:]}"
                )
    return errs


def doctor(root):
    """The gates must still be installed; otherwise the gate quietly uninstalls itself.

    Only harness-neutral gates count. The Stop hook in `.claude/settings.json` is
    a Claude Code convenience: it fires only when that harness runs, so a project
    driven by another agent would report a green gate that can never fire. It is
    therefore not required here, and its absence is not a finding.
    """
    errs = []

    hooks_path = subprocess.run(
        ["git", "config", "core.hooksPath"], cwd=str(root),
        capture_output=True, text=True, check=False,
    ).stdout.strip()
    candidates = []
    if hooks_path:
        base = pathlib.Path(os.path.expanduser(hooks_path))
        candidates.append((base if base.is_absolute() else root / base) / "pre-push")
    candidates.append(root / ".githooks" / "pre-push")
    candidates.append(root / ".git" / "hooks" / "pre-push")
    if not any(p.is_file() and "state-check" in p.read_text(
            encoding="utf-8", errors="replace") for p in candidates):
        errs.append(
            "pre-push gate missing: no pre-push hook mentions state-check "
            f"(looked in {', '.join(str(p) for p in candidates)})"
        )

    workflows = root / ".github" / "workflows"
    ci = [
        p for p in workflows.glob("*.y*ml")
        if "state-check" in p.read_text(encoding="utf-8", errors="replace")
    ] if workflows.is_dir() else []
    if not ci:
        errs.append("CI gate missing: no .github/workflows/*.yml mentions state-check")
    return errs


def main(argv):
    if "version" in argv:
        print(VERSION)
        return 0
    if "doctor" in argv:
        errs = doctor(git_root())
        print("\n".join(f"- {e}" for e in errs) if errs else f"{VERSION}: doctor ok")
        return 1 if errs else 0

    hook = "--hook" in argv
    if hook:
        # Never loop: a second run inside the same stop cycle exits quietly.
        try:
            payload = json.loads(sys.stdin.read() or "{}")
        except ValueError:
            payload = {}
        if payload.get("stop_hook_active"):
            return 0

    root = git_root()
    final = "--final" in argv
    paths = sorted(pathlib.Path(p) for p in glob.glob(str(root / STATE_GLOB)))
    errs = []
    for path in paths:
        st = parse(path)
        found = struct(st, root, final)
        if "--run" in argv and not found:
            found = run(st, root)
        errs += [f"{path.parent.name}: {e}" for e in found]

    if errs:
        print("state-check FAILED:\n- " + "\n- ".join(errs), file=sys.stderr)
        return 2 if hook else 1
    print(f"{VERSION}: ok ({len(paths)} state file{'s' if len(paths) != 1 else ''})")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
