#!/bin/sh
# Re-run the sdlc-state evidence gate before a push. Skip cleanly when this
# branch carries no STATE.md, so unrelated work is not blocked.
# Intentionally --run, not --run --final: --final requires every REQ covered
# and every step [x], which would block pushes mid-work. CI enforces --final.
ls docs/superpowers/state/*/STATE.md >/dev/null 2>&1 || exit 0
exec python3 scripts/state-check --run
